{
  "name": "@repo/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start",
    "cf:build": "npx opennextjs-cloudflare build",
    "cf:dev": "npx opennextjs-cloudflare build && npx wrangler dev",
    "cf:deploy": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy",
    "cf:deploy:staging": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy --env staging",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repo/shared-types": "*",
    "@sentry/nextjs": "^8.26.0",
    "better-auth": "^1.0.0",
    "clsx": "^2.1.1",
    "next": "^14.2.5",
    "posthog-js": "^1.153.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.15.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
