# =============================================================================
# DATABASE (Supabase Postgres)
# =============================================================================

# Pooled connection string — used by apps/api (PgBouncer, serverless-friendly)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string — used by apps/worker (long-running Temporal activities)
DIRECT_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# =============================================================================
# AUTHENTICATION (Better Auth)
# =============================================================================

# A long, random secret used to sign sessions — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# =============================================================================
# REDIS
# =============================================================================

# Redis connection URL — used by apps/api for caching and rate limiting
REDIS_URL="redis://localhost:6379"

# =============================================================================
# TEMPORAL
# =============================================================================

# Temporal server address — defaults to localhost:7233 when not set
TEMPORAL_ADDRESS="localhost:7233"

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Sentry DSN for apps/api (backend error tracking)
SENTRY_DSN=""

# Sentry DSN for apps/web (frontend error tracking — exposed to browser)
NEXT_PUBLIC_SENTRY_DSN=""

# PostHog project API key (frontend product analytics)
NEXT_PUBLIC_POSTHOG_KEY=""

# PostHog host (default: https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# OpenTelemetry — SigNoz collector endpoint (OTLP gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# OTel diagnostic logging (optional: set to "debug" for verbose output)
# OTEL_LOG_LEVEL="debug"

# =============================================================================
# FRONTEND (apps/web)
# =============================================================================

# Full URL of the NestJS API — no trailing slash
NEXT_PUBLIC_API_URL="http://localhost:3001"

# =============================================================================
# CORS & API CONFIGURATION
# =============================================================================

# Frontend URL for CORS configuration
FRONTEND_URL="http://localhost:3000"

# API base URL (used by Better Auth for callback URLs)
API_BASE_URL="http://localhost:3001"

# =============================================================================
# CLOUDFLARE WORKERS
# =============================================================================

# Cloudflare Workers environment
CLOUDFLARE_ENVIRONMENT="development"

# Supabase configuration for Cloudflare Workers
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
