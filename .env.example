# =============================================================================
# DATABASE (Supabase Postgres)
# =============================================================================

# Pooled connection string — used by apps/api (PgBouncer, serverless-friendly)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string — used by apps/worker (long-running Temporal activities)
DIRECT_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# =============================================================================
# AUTHENTICATION (Better Auth)
# =============================================================================

# A long, random secret used to sign sessions — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# =============================================================================
# REDIS
# =============================================================================

# Redis connection URL — used by apps/api for caching and rate limiting
REDIS_URL="redis://localhost:6379"

# =============================================================================
# TEMPORAL
# =============================================================================

# Temporal server address — defaults to localhost:7233 when not set
TEMPORAL_ADDRESS="localhost:7233"

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Sentry DSN for apps/api (backend error tracking)
SENTRY_DSN=""

# Sentry DSN for apps/web (frontend error tracking — exposed to browser)
NEXT_PUBLIC_SENTRY_DSN=""

# PostHog project API key (frontend product analytics)
NEXT_PUBLIC_POSTHOG_KEY=""

# PostHog host (default: https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# OpenTelemetry — SigNoz Foundry ingester (OTLP gRPC; cast via casting.yaml)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# OTel diagnostic logging (optional: set to "debug" for verbose output)
# OTEL_LOG_LEVEL="debug"

# =============================================================================
# LLM (AI Summarization)
# =============================================================================

# LLM provider — "openai" | "anthropic" | "gemini" | "perplexity"
LLM_PROVIDER="openai"

# Model to use for audit summarization
LLM_MODEL="gpt-4o-mini"

# API keys — only the one for your chosen provider is required
# When no key is set, the LLM client runs in mock mode (deterministic responses)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
PERPLEXITY_API_KEY=""

# =============================================================================
# FRONTEND (apps/web)
# =============================================================================

# Full URL of the NestJS API — no trailing slash
NEXT_PUBLIC_API_URL="http://localhost:3001"

# SigNoz UI (Foundry: foundryctl cast -f casting.yaml — port 8080)
NEXT_PUBLIC_SIGNOZ_URL="http://localhost:8080"

# SigNoz MCP server (enabled in casting.yaml — http://localhost:8000)
# Create key in SigNoz UI → Settings → Service Accounts (Admin)
# SIGNOZ_MCP_URL="http://localhost:8000"
# SIGNOZ_API_KEY=""

# =============================================================================
# CORS & API CONFIGURATION
# =============================================================================

# Frontend URL for CORS configuration
FRONTEND_URL="http://localhost:3000"

# API base URL (used by Better Auth for callback URLs)
API_BASE_URL="http://localhost:3001"

# =============================================================================
# CLOUDFLARE WORKERS DEPLOYMENT
# =============================================================================
# Both apps/api and apps/web deploy to Cloudflare Workers.
# Set secrets via: cd apps/api && wrangler secret put <NAME>
#
# API Worker (apps/api):
#   DATABASE_URL              — Supabase DIRECT connection (not pooled!)
#   DIRECT_DATABASE_URL       — Same as DATABASE_URL for Workers
#   BETTER_AUTH_SECRET        — Session signing secret
#   SUPABASE_URL              — Supabase project URL
#   SUPABASE_SERVICE_ROLE_KEY — Supabase service role key
#   FRONTEND_URL              — Comma-separated frontend origins for CORS (include localhost when testing locally against the Worker)
#   API_BASE_URL              — Deployed API URL (e.g., https://genvora-api.workers.dev)
#
# Frontend Worker (apps/web):
#   NEXT_PUBLIC_API_URL                — Deployed API URL
#   NEXT_PUBLIC_SUPABASE_URL           — Supabase project URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — Supabase anon key
#
# Local development: use .env (see above)
# Cloudflare: use wrangler.toml vars + wrangler secret put
